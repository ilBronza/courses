{
    "name": "ilbronza/courses",
    "description": "Gestione corsi, sessioni, date, presenze e responsabilita per il gestionale IlBronza.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide_bronzini@hotmail.com",
            "homepage": "https://sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/courses",
    "keywords": ["Laravel", "Courses"],
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "illuminate/support": ">=10.0",
        "ilbronza/operators": "*",
        "dompdf/dompdf": "^3.1.4"
    },
    "require-dev": {
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\Courses\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\Courses\\Tests\\": "tests",
            "App\\": "tests/Fixtures/App"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\Courses\\CoursesServiceProvider"
            ],
            "aliases": {
                "Courses": "IlBronza\\Courses\\Facades\\Courses"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
